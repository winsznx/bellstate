# Bellstate — root environment reference (PRD §8.9)
#
# This file is a consolidated reference across every app in this monorepo. Each app also has its
# own .env.example (apps/<name>/.env.example) listing only the variables it actually reads —
# use those for real local dev. This root file exists so the full picture is visible in one
# place, and for whichever tooling (CI, Vercel, wrangler) reads env from the repo root.
#
# Real values are never committed here or anywhere else — see .githooks/pre-commit, which blocks
# any .env* file other than .env.example, and blocks diffs containing values from
# internal/secrets/*.env. Status of each credential (who provides it, what it unlocks) is
# tracked in internal/NEEDS.md (gitignored — internal to this build, not part of the product).

# ---- Chain (all Workers) ----

# Comma-separated, wired as a viem `fallback` transport (§4.11). Both are official X Layer RPCs.
XLAYER_RPC_URLS=https://rpc.xlayer.tech,https://xlayerrpc.okx.com

# ---- Signer (apps/signer, one env per signer-a/b/c) ----

# Worker secret. One per signer instance — never shared across signer-a/b/c, never committed,
# never touches the database or logs (§6.1).
SIGNER_PRIVATE_KEY=

# 0, 20 or 40 — which second-past-the-minute this signer polls Nasdaq at (§4.1). signer-a=0,
# signer-b=20, signer-c=40.
SIGNER_SLOT=

# Comma-separated. Every signer POSTs its signed attestations to every URL here (§6.5) —
# typically every aggregator instance, for redundancy.
AGGREGATOR_URLS=

# Gate G1 (blocked — see internal/NEEDS.md #1). Mainnet Chainlink Data Streams HMAC credentials,
# needed for the valuation facet (§4.7).
CHAINLINK_DS_API_KEY=
CHAINLINK_DS_API_SECRET=

# ---- Aggregator (apps/aggregator) ----

# Worker secret. Holds OKB for gas — funded status tracked separately, see internal/NEEDS.md.
SUBMITTER_PRIVATE_KEY=

# ---- Supabase (aggregator, indexer, notifier, watch, api) ----

# Blocked — see internal/NEEDS.md #6. Service-role key, Worker secret, never exposed to the
# browser (that's NEXT_PUBLIC_SUPABASE_ANON_KEY below, a different, public-safe key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- API (apps/api) ----

# Gate G11 (blocked — see internal/NEEDS.md #2). x402 facilitator credentials.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Treasury Safe address — where x402 payments (Print Check, S12) settle.
X402_PAY_TO=

# Blocked — see internal/NEEDS.md #4. Telegram bot token, its webhook's shared secret, and the
# chat ID ops alerts (source-down banners, etc.) post to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPS_TELEGRAM_CHAT_ID=

# Random 32+ byte secret for signing the SIWE session cookie (S13 webhooks, S16 ops). Generate
# with `openssl rand -hex 32` — never reuse across environments.
SESSION_SECRET=

# CI-only. OKLink API for contract-verification lookups.
OKLINK_API_KEY=

# ---- Public URLs (every service) ----

APP_URL=https://bellstate.app
API_URL=https://api.bellstate.app

# ---- Web app (apps/web) — all NEXT_PUBLIC_* are shipped to the browser, never put a secret here ----

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=

# Blocked — see internal/NEEDS.md #5. Reown (WalletConnect) project ID for S05/S06's wallet
# connect modal (G5).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- CI / deploy tooling ----

VERCEL_TOKEN=

# Blocked — see internal/NEEDS.md #7. Needed for every Worker deploy (signer, aggregator,
# indexer, notifier, watch, api). Run `wrangler login` interactively instead if you're deploying
# from a real terminal — this token is only for non-interactive (CI) deploys.
CLOUDFLARE_API_TOKEN=
